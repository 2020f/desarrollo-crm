# Copy to a private .env file. Never publish the real password.
CRM_COMPOSE_PROJECT=desarrollo-crm
CRM_IMAGE=desarrollo-crm:local
# Administrative password: SQL, explicit migrations and maintenance only.
CRM_SQL_PASSWORD=REPLACE_WITH_A_UNIQUE_STRONG_PASSWORD
CRM_SQL_DATABASE=Desarrollo
CRM_SQL_RUNTIME_USER=crm_runtime
# Independent password for the application's DML-only SQL account.
CRM_SQL_RUNTIME_PASSWORD=REPLACE_WITH_A_DIFFERENT_STRONG_PASSWORD
CRM_DATA_DIR=/srv/crm
CRM_HTTP_PORT=5080
# true for an HTTPS Cloudflare hostname. false ONLY for local HTTP tests.
CRM_SECURE_COOKIES=true
# Exact Docker bridge gateway observed from the SQL container after `up sql`.
# Trust only this proxy's X-Forwarded-Proto. See DESPLIEGUE.md.
CRM_TRUSTED_PROXY_IP=
# Express is the free entry edition. Developer is for development/test only.
CRM_SQL_EDITION=Express
# One-time empty-database initialization. No public registration in Production.
# Prefer scripts/deploy/create-env.py to generate strong secrets without printing.
CRM_BOOTSTRAP_EMAIL=admin@example.invalid
CRM_BOOTSTRAP_PASSWORD=
CRM_BOOTSTRAP_FULL_NAME=Administrador
CRM_BOOTSTRAP_ORGANIZATION_NAME=Equipo de desarrollo
